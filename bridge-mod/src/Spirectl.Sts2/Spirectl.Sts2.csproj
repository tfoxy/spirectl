  <!-- The per-game-build compat seam. Deliberately OUTSIDE Live/, which is compiled by a glob behind a
       hand-maintained Exclude mirror; a new subtree there would have to be added to that mirror twice.
       Exactly one lane's directory compiles, chosen by $(Sts2GameApi) (see ../../Sts2GameApi.props). -->
  <ItemGroup Condition="'$(EnableSts2LiveHost)' == 'true'">
    <Compile Include="GameApi/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSts2LiveHost)' == 'true' and '$(Sts2GameApi)' == 'v107'">
    <Compile Include="GameApi/V107/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSts2LiveHost)' == 'true' and '$(Sts2GameApi)' == 'v111'">
    <Compile Include="GameApi/V111/**/*.cs" />
  </ItemGroup>

  <!-- Embedded profile: what an in-process embedder (CouchCoop's private copy) does not compile, and the files
       that stand in for them. The full profile compiles everything above, unchanged. A file leaves the embedded
       copy only when nothing the embedder can reach calls it; Sts2CompileProfileTests pins this list, and the
       embedder's own boundary test proves the built assembly. Removing the lines below is the whole rollback. -->
  <ItemGroup Condition="'$(Sts2Profile)' == 'Embedded'">
    <!-- Stand-ins: the embedded composition, and the one refusal helper that named an excluded file. -->
    <Compile Include="Profiles/Embedded/**/*.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2RuntimeFactory.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2ReusableLiveComposition.cs" />
    <Sts2EmbeddedExcluded Include="GameApi/Sts2GameApiProbe.GameVersion.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2ActionHandler.Dispatch.cs" />

    <!-- The legacy state-extractor lane. The embedded facade reads state through Sts2StateProvider and never
         calls an IGameStateExtractor, so the profile's runtime services have no extractor slot at all
         (SpirectlRuntimeServices and the facade's factories compile it out behind SPIRECTL_PROFILE_EMBEDDED). -->
    <Sts2EmbeddedExcluded Include="Core/State/GameStateSnapshot.Full.cs" />
    <Sts2EmbeddedExcluded Include="Core/State/IGameStateExtractor.cs" />
    <Sts2EmbeddedExcluded Include="Core/State/PlaceholderStateExtractor.cs" />
    <Sts2EmbeddedExcluded Include="Core/State/PresentationScaffoldState.cs" />
    <Sts2EmbeddedExcluded Include="Core/State/ObservedGameStateExtractor.cs" />
    <Sts2EmbeddedExcluded Include="Core/State/RuntimeStateMapper.cs" />
    <Sts2EmbeddedExcluded Include="Core/State/ScaffoldRuntimeObservationProvider.cs" />
    <Sts2EmbeddedExcluded Include="Core/State/IRuntimeObservationProvider.cs" />
    <Sts2EmbeddedExcluded Include="Core/State/BridgeRuntimeObservation.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2RuntimeObservationProvider.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2LobbyPresentationGeometryResolver.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2PresentationStateResolver.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2CardOverlayInspector.cs" />
    <Sts2EmbeddedExcluded Include="Common/Sts2UnsupportedScreenNotice.cs" />
    <Sts2EmbeddedExcluded Include="Core/Models/RandomCharacterFacts.cs" />

    <!-- The reference-data provider implementation. The Core/Reference DTOs and the IGameReferenceSource port
         stay: ISpirectlRuntime inherits them. -->
    <Sts2EmbeddedExcluded Include="Live/Sts2ReferenceDataProvider.cs" />

    <!-- Synthetic host-local seats: the watchers arm only on synthetic-seat demand, and the only code that
         registers a synthetic seat is the lobby-join action the embedded dispatcher does not carry. -->
    <Sts2EmbeddedExcluded Include="Live/Sts2HostLocalSeatSyncWatcher.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2HostLocalSeatTurnWatcher.cs" />

    <!-- The VFX-spawn hook: a Harmony postfix on the game's generic add-child helper that only feeds the
         combat-event hub, which nothing in an embedder subscribes to. -->
    <Sts2EmbeddedExcluded Include="Live/Sts2VfxSpawnEventHooks.cs" />

    <!-- Found by a reachability pass over the embedded sources rather than named in advance: nothing an
         embedder can reach calls them. Each has a bridge or test caller only (the resource-reference collector:
         tests; the two encounter-visual files: the bridge host's startup). -->
    <Sts2EmbeddedExcluded Include="Core/State/StateResourceReferenceCollector.cs" />
    <Sts2EmbeddedExcluded Include="Live/EncounterVisuals/Sts2EncounterVisualEventStore.cs" />
    <Sts2EmbeddedExcluded Include="Live/EncounterVisuals/Sts2KaiserCrabVisualHooks.cs" />

    <!-- Action bodies no embedded dispatch arm reaches (see Profiles/Embedded/Sts2ActionHandler.Dispatch.cs). -->
    <Sts2EmbeddedExcluded Include="Live/Sts2ActionHandler.CardPile.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2ActionHandler.Combat.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2ActionHandler.DeckView.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2ActionHandler.HandSelection.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2ActionHandler.InspectRelic.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2ActionHandler.TopBar.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2ActionHandler.ContextOwnership.Full.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2ActionHandler.FailuresInputTypes.Full.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2ActionHandler.RewardCommit.Full.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2ActionHandler.ScreenIntents.Full.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2ActionHandler.ShopMapLobby.Full.cs" />

    <!-- Most of the state-side action catalog (the AvailableAction builders): only the observation provider and
         the action bodies above called them. The retained half keeps the two members a live arm still reads. -->
    <Sts2EmbeddedExcluded Include="Common/Sts2ActionCatalog.Full.cs" />

    <!-- Left with no caller once the action bodies above are gone: only those bodies, the observation
         provider, the bridge or tests named them. -->
    <Sts2EmbeddedExcluded Include="Live/Sts2MainMenuStartRunHooks.cs" />
    <Sts2EmbeddedExcluded Include="Live/Sts2CrystalSphereScreenInspector.cs" />
    <Sts2EmbeddedExcluded Include="Common/Sts2LobbyCharacterButtonInvoker.cs" />
    <Sts2EmbeddedExcluded Include="Common/Sts2PartialChoiceNotice.cs" />
    <Sts2EmbeddedExcluded Include="Core/Map/Sts2MapDrawingTransform.cs" />

    <Compile Remove="@(Sts2EmbeddedExcluded)" />
  </ItemGroup>

