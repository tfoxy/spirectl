  <!-- The per-game-build compat seam. Deliberately OUTSIDE Live/, which is compiled by a glob behind a
       hand-maintained Exclude mirror; a new subtree there would have to be added to that mirror twice.
       Exactly one lane's directory compiles, chosen by $(Sts2GameApi) (see ../../Sts2GameApi.props). -->
  <ItemGroup Condition="'$(EnableSts2LiveHost)' == 'true'">
    <Compile Include="GameApi/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSts2LiveHost)' == 'true' and '$(Sts2GameApi)' == 'v107'">
    <Compile Include="GameApi/V107/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSts2LiveHost)' == 'true' and '$(Sts2GameApi)' == 'v111'">
    <Compile Include="GameApi/V111/**/*.cs" />
  </ItemGroup>

  <Target Name="ValidateSts2LiveHostReferences" BeforeTargets="ResolveReferences" Condition="'$(EnableSts2LiveHost)' == 'true'">
    <Error Condition="'$(Sts2AssembliesDir)' == ''" Text="Missing Sts2AssembliesDir for EnableSts2LiveHost=true." />
    <Error Condition="'$(Sts2AssembliesDir)' != '' and !Exists('$(Sts2AssembliesDir)/sts2.dll')" Text="Missing STS2 live-host assembly: $(Sts2AssembliesDir)/sts2.dll" />
    <Error Condition="'$(Sts2AssembliesDir)' != '' and !Exists('$(Sts2AssembliesDir)/GodotSharp.dll')" Text="Missing STS2 live-host assembly: $(Sts2AssembliesDir)/GodotSharp.dll" />
    <Error Condition="'$(Sts2AssembliesDir)' != '' and !Exists('$(Sts2AssembliesDir)/0Harmony.dll')" Text="Missing STS2 live-host assembly: $(Sts2AssembliesDir)/0Harmony.dll" />
  </Target>
</Project>
