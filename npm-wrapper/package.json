      "import": "./src/playwright.js"
    }
  },
  "types": "./src/index.d.ts",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tfoxy/spirectl.git"
  },
  "bugs": {
    "url": "https://github.com/tfoxy/spirectl/issues"
  },
  "homepage": "https://github.com/tfoxy/spirectl#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
