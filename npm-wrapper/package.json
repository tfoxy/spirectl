{
  "name": "@spirectl/sts2",
  "version": "0.1.0",
  "description": "Node wrapper and release-backed launcher for the sts2 CLI.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "README.md",
    "bin/",
    "src/",
    "examples/"
  ],
  "bin": {
    "sts2": "./bin/sts2.js",
    "sts2-mcp": "./bin/sts2-mcp.js"
