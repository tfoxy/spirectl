<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Spirectl.DotnetTools\Spirectl.DotnetTools.csproj" />
    <ProjectReference Include="..\Spirectl.DotnetTools.TestSymbols\Spirectl.DotnetTools.TestSymbols.csproj" />
    <ProjectReference Include="..\Spirectl.DotnetTools.TestGameConsumer\Spirectl.DotnetTools.TestGameConsumer.csproj" />
    <!--
      The reshaped game surface repeats the control build's namespaces and type names on purpose, so
      it is referenced under an alias: the test code needs its built file on disk, never its types.
    -->
    <ProjectReference Include="..\Spirectl.DotnetTools.TestGameSymbols.Reshaped\Spirectl.DotnetTools.TestGameSymbols.Reshaped.csproj" Aliases="reshaped" />
  </ItemGroup>
</Project>
